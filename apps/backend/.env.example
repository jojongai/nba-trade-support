# Copy to .env locally. On Vercel, set these in Project → Settings → Environment Variables.

OPENAI_API_KEY=
# Optional alternate name supported by the app:
# OPEN_AI_API_KEY=

# Comma-separated browser origins (always include your production frontend URL).
CORS_ORIGINS=http://localhost:3000

# Optional regex for preview hosts. Default matches any https://*.vercel.app. Set to empty to disable.
# CORS_ORIGIN_REGEX=
